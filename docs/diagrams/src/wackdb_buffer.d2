direction: down

vars: {
  d2-config: {
    theme-id: 301
  }
}

classes: {
  struct: {
    shape: class
    style: { border-radius: 4 }
  }
  external: {
    style: { stroke-dash: 5; opacity: 0.7 }
  }
}

wackdb_buffer: {
  BufferPoolManager: {
    class: struct
    "-frames": "Vec<RwLock<SlottedPage>>"
    "-descriptors": "Vec<FrameDescriptor>"
    "-page_table": "Mutex<HashMap<PageId, usize>>"
    "-replacer": LRUReplacer
    "-disk_manager": DiskManager
    +fetch_page(): "Result<usize, BufferError>"
    +unpin_page(): "Result<(), BufferError>"
  }

  LRUReplacer: {
    class: struct
    "-capacity": usize
    "-lru_list": "Mutex<VecDeque<usize>>"
    "-pinned": "Mutex<Vec<bool>>"
    +evict(): "Option<usize>"
  }
  
  LogManager: {
    class: struct
    "-log_buffer": "Vec<u8>"
    "-flushed_lsn": u64
    +append(): u64
  }
  
  BufferPoolManager -> LRUReplacer: "Evicts victim frames"
  BufferPoolManager -> LogManager: "Enforces WAL before data write"
}

wackdb_storage: { class: external }
wackdb_wal: { class: external }
wackdb_page: { class: external }

wackdb_buffer.BufferPoolManager -> wackdb_storage: "Reads/Writes Pages"
wackdb_buffer.BufferPoolManager -> wackdb_page: "Manages SlottedPages"
wackdb_buffer.LogManager -> wackdb_wal: "Appends log records"
